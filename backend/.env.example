# ==============================================================================
# SYSTEM-WIDE SERVER & ADMIN ENVIRONMENT CONFIGURATION
# (Managed strictly by Server/Admin Environment - not exposed to individual users)
# ==============================================================================

# LinkedIn OAuth App Credentials (System-Wide OAuth Application)
LINKEDIN_CLIENT_ID=your_system_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_system_linkedin_client_secret_here
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback

# Optional: System Fallback Access Token (if headless or single-account backend)
LINKEDIN_ACCESS_TOKEN=

# Admin Dashboard Credentials
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_TOKEN=your_secure_admin_token

# Cryptographic Key for securing stored user tokens and API keys (AES-256 Fernet)
# Can be any 32+ char secret string or Fernet URL-safe base64 string
ENCRYPTION_KEY=generate_a_secure_random_key_or_passphrase_here

# Database & Supabase Configuration
# Local SQLite fallback: sqlite:///./posts.db
DATABASE_URL=sqlite:///./posts.db

# Supabase (PostgreSQL) Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Service Role Key for backend administrative queries & migrations (Keep SECRET, server-only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Anon Key for public frontend client operations
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# ==============================================================================
# SYSTEM AI FALLBACK (Optional)
# Note: Users provide and manage their own Gemini API keys upon onboarding via:
# POST /api/user/ai-auth (stored securely and encrypted in database).
# This system key is used ONLY as an optional global fallback.
# ==============================================================================
GOOGLE_API_KEY=
MODEL_NAME=gemini-3.6-flash
